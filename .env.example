# ── Sanity (leave empty to build with the built-in sample content) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Set to local for built-in development content; remove to use Sanity again.
# CONTENT_SOURCE=local

# Only needed for `npm run seed` (Sanity → API → Tokens → Editor token). Never commit.
SANITY_WRITE_TOKEN=

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Contact form (free key from https://web3forms.com). Empty = form opens WhatsApp instead. ──
NEXT_PUBLIC_WEB3FORMS_KEY=

# Secret shared with the Sanity webhook (server only; never expose in NEXT_PUBLIC_ variables).
SANITY_REVALIDATE_SECRET=

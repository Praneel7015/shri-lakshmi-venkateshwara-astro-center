# ── Sanity (leave empty to build with the built-in sample content) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed for `npm run seed` (Sanity → API → Tokens → Editor token). Never commit.
SANITY_WRITE_TOKEN=

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Contact form (free key from https://web3forms.com). Empty = form opens WhatsApp instead. ──
NEXT_PUBLIC_WEB3FORMS_KEY=

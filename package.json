{
  "name": "astro-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs && node scripts/build-studio.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "seed": "tsx scripts/seed.mts",
    "dev:studio": "npm run dev --prefix studio",
    "setup": "npm install && npm install --prefix studio",
    "export-content": "tsx scripts/export-content.mts"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}

# ─────────────────────────────────────────────────────────────────────
# Apache rules for GoDaddy cPanel. Copied into out/ on every build.
#
# The site is built as  out/en/...  (English) and  out/kn/...  (Kannada).
# Visitors see English at /about/ and Kannada at /kn/about/.
# `scripts/serve.mjs` copies these rules for local testing. Keep both in step.
# ─────────────────────────────────────────────────────────────────────

ErrorDocument 404 /404.html
Options -Indexes -MultiViews
DirectoryIndex index.html

# The live folder is a git checkout (see README → Hosting). Never serve git files.
RedirectMatch 404 /\.git

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS and drop "www." (must match NEXT_PUBLIC_SITE_URL)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2. Old-style /en/... links → /... (English has no prefix).
  #    THE_REQUEST = what the browser asked for, so rule 6 can't loop back here.
  RewriteCond %{THE_REQUEST} \s/en(/|\s|\?)
  RewriteRule ^en/?(.*)$ /$1 [R=301,L]

  # 2b. The content editor (Sanity Studio) is a single-page app at /studio/.
  #     Any /studio/... address that isn't a real file loads its index.html.
  RewriteRule ^studio$ /studio/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^studio/ /studio/index.html [L]

  # 3. Add the trailing slash to page URLs: /about → /about/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # 4. Real files (/_next/, sitemap.xml, robots.txt, images…) are served as-is
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. Kannada pages and already-rewritten English pages are served as-is
  RewriteRule ^(kn|en)(/|$) - [L]

  # 6. Everything else is English: /about/ → out/en/about/
  RewriteRule ^(.*)$ /en/$1 [L]
</IfModule>

# ── Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# ── Caching: hashed build files forever, HTML always fresh ──
<IfModule mod_headers.c>
  # Files in /_next/static/ have a hash in their name, so they never change.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|svg|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

AddType application/manifest+json .webmanifest
